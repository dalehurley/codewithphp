{
    "name": "codewithphp/bang-for-buck-shop",
    "description": "The Laravel shop used in the Bang for Buck performance labs.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.5.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
