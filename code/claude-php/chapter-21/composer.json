{
    "name": "claude-php/chapter-21-laravel-integration",
    "description": "Laravel Integration Patterns for Claude AI",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "claude-php/claude-php-sdk": "^0.5",
        "illuminate/support": "^11.0",
        "illuminate/cache": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^9.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ClaudePhp\\LaravelIntegration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudePhp\\LaravelIntegration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClaudePhp\\LaravelIntegration\\ClaudeServiceProvider"
            ],
            "aliases": {
                "Claude": "ClaudePhp\\LaravelIntegration\\Facades\\Claude"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
