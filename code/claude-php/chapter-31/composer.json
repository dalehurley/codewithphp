{
    "name": "claude-php/chapter-31-rag",
    "description": "Chapter 31: Retrieval Augmented Generation with Claude",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "anthropic-ai/anthropic-sdk-php": "^0.9",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "symfony/dotenv": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
