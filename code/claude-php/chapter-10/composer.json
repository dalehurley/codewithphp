{
    "name": "claude-php/chapter-10-error-handling",
    "description": "Error handling and rate limiting for Claude API",
    "type": "project",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ClaudePHP\\ErrorHandling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudePHP\\ErrorHandling\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
