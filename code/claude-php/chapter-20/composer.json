{
    "name": "claude-php/chapter-20-realtime-chat",
    "description": "Real-time Chat with WebSockets and Claude AI",
    "type": "project",
    "require": {
        "php": "^8.2",
        "claude-php/claude-3-api": "^1.0",
        "vlucas/phpdotenv": "^5.5",
        "ratchet/ratchet": "^0.4",
        "ratchet/pawl": "^0.4",
        "react/http": "^1.9",
        "predis/predis": "^2.2",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "ClaudePhp\\RealtimeChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudePhp\\RealtimeChat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "websocket": "php examples/websocket-server.php",
        "chat": "php examples/chat-demo.php"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
