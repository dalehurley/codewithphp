{
    "name": "codewithphp/claude-php-shared",
    "description": "Shared utilities for Claude for PHP Developers series",
    "type": "library",
    "require": {
        "php": "^8.2",
        "anthropic-ai/sdk": "^1.0",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.0",
        "symfony/cache": "^7.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CodeWithPHP\\ClaudeShared\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeWithPHP\\ClaudeShared\\Tests\\": "tests/"
        }
    }
}
