{
    "name": "claude-php/chapter-30-data-extraction",
    "description": "Chapter 30: Data Extraction and Analysis - ETL pipelines with Claude",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "anthropic-ai/anthropic-sdk-php": "^0.9",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "symfony/dotenv": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "symfony/console": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
