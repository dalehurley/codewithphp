---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { isHomepage } from '../lib/seo';

const { entry, hasSidebar, siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const isHome = isHomepage(entry.slug);
const homeAnchor = isHome ? '' : siteTitleHref;

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class:list={['header', { 'studio-header': isHome }]}>
  <div class="title-wrapper sl-flex">
    <a class="site-brand" href={siteTitleHref} translate="no">
      <img class="site-brand__mark" src="/images/brand/pinup-mark.png" width="40" height="40" alt="" />
      {siteTitle}
    </a>
  </div>
  <nav class="site-links print:hidden" aria-label="Main">
    <a href={isHome ? '#learn' : '/series/'}>Learn</a>
    <a href={homeAnchor + '#play'}>Play</a>
    <a href={homeAnchor + '#connect'}>Connect</a>
  </nav>
  <div class="header-search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  {!isHome && (
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      {hasSidebar && (
        <button class="sl-sidebar-toggle" type="button" data-sidebar-toggle aria-pressed="false">
          Hide sidebar
        </button>
      )}
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  )}
</div>

<script is:inline>
  (() => {
    const storageKey = 'sl-sidebar-hidden';
    const root = document.documentElement;
    const button = document.querySelector('[data-sidebar-toggle]');

    if (!button) return;

    const updateButton = () => {
      const hidden = root.hasAttribute('data-sidebar-hidden');
      button.setAttribute('aria-pressed', hidden ? 'true' : 'false');
      button.textContent = hidden ? 'Show sidebar' : 'Hide sidebar';
    };

    updateButton();

    button.addEventListener('click', () => {
      const hidden = root.toggleAttribute('data-sidebar-hidden');
      if (hidden) {
        try {
          localStorage.setItem(storageKey, 'true');
        } catch {
          // Ignore storage errors (e.g., private mode).
        }
      } else {
        try {
          localStorage.removeItem(storageKey);
        } catch {
          // Ignore storage errors (e.g., private mode).
        }
      }
      updateButton();
    });
  })();
</script>

<style>
  @layer starlight.core {
    .header:not(.studio-header) {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    .header:not(.studio-header) .site-links {
      display: none;
    }

    @media (min-width: 69rem) {
      .header:not(.studio-header) {
        display: grid;
        grid-template-columns: auto 1fr minmax(8rem, 16rem) auto;
      }

      .header:not(.studio-header) .site-links {
        display: flex;
        justify-content: center;
      }
    }
  }
</style>
