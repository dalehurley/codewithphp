---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import ResumeLesson from './ResumeLesson.astro';
import { isHomepage, stripChapterNumber } from '../lib/seo';

const { entry } = Astro.locals.starlightRoute;
const isLesson = /^series\/[^/]+\/chapters\//.test(entry.slug);
const isDocument = !isHomepage(entry.slug) && entry.slug !== 'series' && entry.slug !== '404';
const href = '/' + entry.slug + '/';
const title = stripChapterNumber(entry.data.title);
const issueUrl = new URL('https://github.com/dalehurley/codewithphp/issues/new');

if (isDocument) {
  const page = new URL(href, Astro.site);
  issueUrl.searchParams.set('title', (isLesson ? 'Example problem in ' : 'Page problem in ') + title);
  issueUrl.searchParams.set('body', [
    (isLesson ? 'Lesson: ' : 'Page: ') + page.href,
    '',
    isLesson ? 'PHP version (`php -v`):' : 'PHP version (`php -v`), if relevant:',
    'Operating system:',
    'Command or example:',
    'Expected result:',
    'Actual output or exact error (remove private details):',
    '',
  ].join('\n'));
}
---

{isLesson && <ResumeLesson lesson={{ href, title }} />}
{isDocument && (
  <>
    <span hidden data-print-doc></span>
    <p class="lesson-feedback print:hidden">
      <a href={issueUrl}>{isLesson ? 'Report a problem with this example' : 'Report a problem with this page'}</a>
    </p>
  </>
)}
<DefaultFooter />

<style>
  .lesson-feedback {
    margin-block-start: 2rem;
    font-size: var(--sl-text-sm);
  }
</style>
