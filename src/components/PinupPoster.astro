---
interface Props {
  sizes: string;
}

const { sizes } = Astro.props;
---

<div class="studio-poster">
  <img
    src="/images/brand/php-pinup-720.webp"
    srcset="/images/brand/php-pinup-720.webp 720w, /images/brand/php-pinup-1160.webp 1160w"
    {sizes}
    width="1160"
    height="1353"
    fetchpriority="high"
    decoding="async"
    alt="Halftone pin-up illustration of a programmer in red cat-eye glasses at a vintage computer"
  />
  <span class="studio-poster__tag" aria-hidden="true">{'<?php'}</span>
</div>
