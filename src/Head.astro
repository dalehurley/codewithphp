---
import { hasMarkdownAlternate, markdownPathFor } from './lib/agent-docs';
import { findEntryBySlug } from './lib/collection-cache';
import { catalogueTracks } from './lib/course-catalogue';
import { getSeriesSlug, getSocialPreview, isComparisonPage, isCourseResource, isHomepage, isSeriesIndex, stripChapterNumber } from './lib/seo';
import {
  generateArticleSchema,
  generateBreadcrumbSchema,
  generateCourseListSchema,
  generateCourseSchema,
  generateHomepageSchemas,
} from './lib/structured-data';

const { entry, head, lang, siteTitle } = Astro.locals.starlightRoute;
const { slug, data } = entry;
const isHome = isHomepage(slug);
const isCatalogue = slug === 'series';
const isCourse = isSeriesIndex(slug);
const isLesson = isCourseResource(slug);
const isComparison = isComparisonPage(slug);
const isArticle = isLesson || isComparison;
const isNotFound = slug === '404' || Astro.response.status === 404;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const homeUrl = new URL('/', Astro.site ?? Astro.url);

const canonicalHref = head.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical')?.attrs?.href;
const canonical = new URL(typeof canonicalHref === 'string' ? canonicalHref : Astro.url.pathname, homeUrl);
const description = String(head.find(({ tag, attrs }) => tag === 'meta' && attrs?.name === 'description')?.attrs?.content ??
  'Free, practical PHP courses with runnable examples and real projects.');
const configuredRobots = head.find(({ tag, attrs }) => tag === 'meta' && attrs?.name === 'robots')?.attrs?.content;
const robots = typeof configuredRobots === 'string' ? configuredRobots : undefined;
const explicitlyExcluded = /\b(?:noindex|none)\b/i.test(robots ?? '');
const isIndexable = !isNotFound && !data.draft && !data.noindex && !explicitlyExcluded;
const robotsContent = isIndexable || explicitlyExcluded
  ? robots ?? 'index, follow, max-image-preview:large'
  : 'noindex, follow';

const title = isLesson ? stripChapterNumber(data.title) : data.title;
const searchTitle = data.seoTitle ?? title;
const site = { name: siteTitle, url: homeUrl.href, language: lang };
const catalogueUrl = new URL('/series/', homeUrl).href;
const series = isLesson ? getSeriesSlug(slug) : undefined;
const courseSlug = series ? `series/${series}` : undefined;
const course = courseSlug ? await findEntryBySlug(courseSlug) : undefined;
const image = getSocialPreview(slug, title, siteTitle, course?.data.title, data);
const imageUrl = new URL(image.path, homeUrl).href;

const schemas: object[] = [];
if (isIndexable) {
  const page = {
    ...data,
    title,
    url: canonical.href,
    description,
    image: imageUrl,
  };

  if (isHome) {
    schemas.push(...generateHomepageSchemas(site, description));
  } else {
    const breadcrumbs = [{ name: 'Home', url: homeUrl.href }];
    if (isCourse || isLesson) {
      breadcrumbs.push({ name: 'All courses', url: catalogueUrl });
    }
    if (isComparison) {
      breadcrumbs.push({ name: 'PHP comparisons', url: new URL('/compare/', homeUrl).href });
    }
    if (courseSlug && course && !course.data.draft && !course.data.noindex) {
      breadcrumbs.push({ name: course.data.title, url: new URL(`/${courseSlug}/`, homeUrl).href });
    }
    breadcrumbs.push({ name: isCatalogue ? 'All courses' : title, url: canonical.href });
    schemas.push(generateBreadcrumbSchema(breadcrumbs));
  }

  if (isCatalogue) {
    const urls = catalogueTracks.flatMap(({ courses }) =>
      courses.map((courseSlug) => new URL(`/series/${courseSlug}/`, homeUrl).href));
    schemas.push(generateCourseListSchema(urls));
  } else if (isCourse) {
    schemas.push(generateCourseSchema(site, page));
  } else if (isArticle) {
    schemas.push(generateArticleSchema(site, page, image.alt === title));
  }
}

const replacedMetaNames = new Set(['robots', 'twitter:card', 'twitter:title', 'twitter:description', 'twitter:image', 'twitter:image:alt']);
const replacedMetaProperties = new Set(['og:title', 'og:type', 'og:url', 'og:description', 'og:image', 'og:image:alt', 'og:image:width', 'og:image:height']);
const nativeHead = head.filter(({ tag, attrs }) => {
  if (isNotFound && tag === 'link' && attrs?.rel === 'canonical') return false;
  if (tag !== 'meta') return true;
  return !replacedMetaNames.has(String(attrs?.name)) && !replacedMetaProperties.has(String(attrs?.property));
});
---

{nativeHead.map(({ tag: Tag, attrs, content }) => Tag === 'title' ? (
  <title>{searchTitle} | {siteTitle}</title>
) : (
  <Tag {...attrs} set:html={content} />
))}
<meta name="robots" content={robotsContent} />

{isIndexable && hasMarkdownAlternate(entry) && (
  <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownPathFor(canonical.pathname)} />
)}

{isIndexable && (
  <>
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={searchTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={image.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={searchTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />

    {isArticle && data.datePublished && <meta property="article:published_time" content={data.datePublished} />}
    {isArticle && data.dateModified && <meta property="article:modified_time" content={data.dateModified} />}
  </>
)}

{isHome && verification && <meta name="google-site-verification" content={verification} />}

{isIndexable && analyticsToken && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: analyticsToken })}
  ></script>
)}

{schemas.map((value) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(value).replace(/</g, '\\u003c')} />
))}

<script is:inline>
  (() => {
    const storageKey = 'sl-sidebar-hidden';
    try {
      if (localStorage.getItem(storageKey) === 'true') {
        document.documentElement.setAttribute('data-sidebar-hidden', '');
      }
    } catch {
      // Ignore storage errors (e.g., private mode).
    }
  })();
</script>
